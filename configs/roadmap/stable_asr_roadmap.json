        {"path": "configs/final/paper_final.json", "required_now": true},
        {"path": "configs/final/input_collections.json", "required_now": true},
        {"path": "configs/final/asr_command_compare.json", "required_now": true},
        {"path": "configs/benchmarks/stable_asr_v0.json", "required_now": true},
        {"path": "configs/schemas/stable_asr_schemas.json", "required_now": true},
        {"path": "stable_asr/paper/artifacts.py", "required_now": true},
        {"path": "stable_asr/paper/audit.py", "required_now": true},
        {"path": "stable_asr/paper/benchmark_pack.py", "required_now": true},
        {"path": "stable_asr/paper/scenario_pack.py", "required_now": true},
        {"path": "stable_asr/paper/submissions.py", "required_now": true},
        {"path": "stable_asr/paper/leaderboard.py", "required_now": true},
        {"path": "stable_asr/schemas.py", "required_now": true},
        {"path": "stable_asr/schema_validation.py", "required_now": true},
        {"path": "stable_asr/paper/provenance.py", "required_now": true},
        {"path": "stable_asr/paper/integrity.py", "required_now": true},
        {"path": "stable_asr/paper/parity.py", "required_now": true},
        {"path": "stable_asr/paper/final_experiments.py", "required_now": true},
        {"path": "stable_asr/paper/final_inputs.py", "required_now": true},
        {"path": "stable_asr/paper/final_config.py", "required_now": true},
        {"path": "stable_asr/paper/final_pack.py", "required_now": true},
