      "commands": [
        "stable-asr reproduce-paper --config configs/paper/paper_smoke.json",
        "stable-asr paper-bundle --results runs/paper/smoke/paper_results.json --output-dir runs/paper/smoke/artifacts",
        "stable-asr paper-status --results runs/paper/smoke/paper_results.json --artifacts-dir runs/paper/smoke/artifacts",
        "stable-asr final-config --config configs/final/paper_final.json --audit-asr-commands",
        "stable-asr schema-registry --registry configs/schemas/stable_asr_schemas.json --validate-only",
        "stable-asr validate-schema-file --input examples/data/turn_demo.jsonl --schema-id stable_asr.turn_manifest_record.v0",
        "stable-asr benchmark-pack --output-dir runs/benchmark_pack",
        "stable-asr scenario-pack --output-dir runs/scenario_pack",
        "stable-asr final-pack --output-dir runs/final_pack",
        "stable-asr final-acquisition-pack --output-dir runs/final_acquisition_pack",
        "stable-asr contributor-pack --output-dir runs/contributor_pack",
        "stable-asr turn-submission --dataset examples/data/turn_demo.jsonl --predictions tests/fixtures/turn_predictions_sample.jsonl --system oracle_fixture --output-dir runs/submissions/oracle_fixture",
        "stable-asr streaming-submission --input tests/fixtures/streaming_asr_sample.jsonl --system streaming_fixture --output-dir runs/submissions/streaming_fixture",
        "stable-asr submission-index --root runs/submissions --output-dir runs/submissions/leaderboard",
        "stable-asr leaderboard-merge --input runs/submissions/oracle_fixture/leaderboard.jsonl --input runs/submissions/streaming_fixture/leaderboard.jsonl --output runs/submissions/leaderboard.jsonl --validation-output runs/submissions/LEADERBOARD_VALIDATION.md --report-output runs/submissions/LEADERBOARD_REPORT.md",
        "stable-asr paper-release-audit --repo-root . --results runs/paper/smoke/paper_results.json --artifacts-dir runs/paper/smoke/artifacts"
      ],
      "success_criteria": [
        "smoke artifacts have stable tables, figures, claim audits, bundle manifests, provenance, and integrity hashes",
        "release audit separates structural readiness from final-scale missing evidence",
        "leaderboard exports are generated from paper result artifacts",
        "paper bundles include contributor benchmark and adapter starter packs under release-audited required artifacts",
        "external data and artifact contracts are published as versioned JSON Schemas",
        "JSON/JSONL artifacts can be validated directly against those contracts",
        "external contributors can generate a self-contained benchmark starter pack with schemas, suite metadata, fixtures, and runnable submission commands",
        "external scenario contributors can generate a self-contained VoiceWorld starter pack with suite metadata, editable annotations, and runnable evaluation commands",
        "paper contributors can generate a self-contained final-run starter pack with configs, audits, runbooks, references, and scaffold directories without fake benchmark evidence",
        "paper contributors can generate a self-contained final input acquisition pack with staging, license/consent, recording, and handoff checklists",
        "contributors can generate one onboarding pack containing every public contribution starter pack plus GitHub issue and PR templates",
        "external turn model submissions can produce auditable validation, evaluation, and leaderboard packages",
        "external streaming ASR submissions can produce auditable validation, evaluation, and leaderboard packages",
        "submission directories can be indexed into a community submission report and merged leaderboard",
        "multiple external submission leaderboards can be merged into one validated ranked report"
      ]
