{
  "id": "stable_asr_roadmap_v0",
  "version": "0.1.0",
  "title": "Stable-ASR Platform Roadmap",
  "description": "Machine-readable roadmap for turning Stable-ASR into a stable-worldmodel-style platform for reproducible real-time ASR and full-duplex turn-taking research.",
  "milestones": [
    {
      "id": "m0_platform_foundation",
      "title": "Platform Foundation",
      "status": "complete",
      "objective": "Provide an installable package, CLI, documentation entrypoint, CI, and release audit surface.",
      "artifacts": [
        {"path": "pyproject.toml", "required_now": true},
        {"path": "README.md", "required_now": true},
        {"path": "ROADMAP.md", "required_now": true},
        {"path": "docs/index.md", "required_now": true},
        {"path": ".github/workflows/tests.yml", "required_now": true},
        {"path": "stable_asr/cli.py", "required_now": true},
        {"path": "CITATION.cff", "required_now": true}
      ],
      "commands": [
        "stable-asr doctor",
        "python3 -m pytest -q"
      ],
      "success_criteria": [
        "package installs locally",
        "CLI smoke commands run in CI",
        "release audit can inspect required repository files"
      ]
    },
    {
      "id": "m1_turn_suite",
      "title": "Turn Suite And NanoTurn Baselines",
      "status": "complete",
      "objective": "Make turn-taking, endpointing, prediction manifests, and NanoTurn checkpoints reproducible under one interface.",
      "artifacts": [
        {"path": "stable_asr/data/manifest.py", "required_now": true},
        {"path": "stable_asr/turn/nanoturn.py", "required_now": true},
        {"path": "stable_asr/models/baselines/vad_pause.py", "required_now": true},
        {"path": "stable_asr/models/baselines/rule_endpoint.py", "required_now": true},
        {"path": "stable_asr/models/baselines/text_turn.py", "required_now": true},
        {"path": "stable_asr/models/adapters/turn_prediction.py", "required_now": true},
        {"path": "stable_asr/models/adapters/prediction_audit.py", "required_now": true},
        {"path": "stable_asr/eval/turn_eval.py", "required_now": true},
        {"path": "stable_asr/eval/turn_compare.py", "required_now": true},
        {"path": "stable_asr/train/turn_trainer.py", "required_now": true},
        {"path": "tests/fixtures/turn_predictions_sample.jsonl", "required_now": true}
      ],
      "commands": [
        "stable-asr eval-turn --dataset examples/data/turn_demo.jsonl --baseline vad_pause",
        "stable-asr predict-turn --dataset examples/data/turn_demo.jsonl --baseline text_turn --output /tmp/stable-asr-text-turn-predictions.jsonl",
        "stable-asr validate-turn-predictions --dataset examples/data/turn_demo.jsonl --predictions /tmp/stable-asr-text-turn-predictions.jsonl",
        "stable-asr compare-turn --dataset examples/data/turn_demo.jsonl --baseline vad_pause --baseline text_turn --predictions oracle=tests/fixtures/turn_predictions_sample.jsonl"
      ],
      "success_criteria": [
        "built-in baselines and external prediction manifests share one evaluator",
        "prediction manifests are coverage-checked before benchmark use",
        "NanoTurn checkpoints can be trained, evaluated, benchmarked, and exported"
      ]
    },
    {
      "id": "m2_data_reference_layer",
      "title": "Data And Reference Layer",
      "status": "complete",
      "objective": "Standardize turn/ASR manifests, data conversions, ASR reference collections, and adapter planning around top open-source ASR systems.",
      "artifacts": [
        {"path": "configs/datasets/stable_asr_sources.json", "required_now": true},
        {"path": "configs/references/asr_collections.json", "required_now": true},
        {"path": "configs/references/turn_collections.json", "required_now": true},
        {"path": "configs/adapters/stable_asr_adapters.json", "required_now": true},
        {"path": "docs/asr_collections.md", "required_now": true},
        {"path": "docs/turn_collections.md", "required_now": true},
        {"path": "stable_asr/data/asr_manifest.py", "required_now": true},
        {"path": "stable_asr/data/recipes/asr_folder.py", "required_now": true},
        {"path": "stable_asr/data/recipes/public_corpora.py", "required_now": true},
        {"path": "stable_asr/data/turn_from_asr.py", "required_now": true},
        {"path": "stable_asr/data/bootstrap.py", "required_now": true},
        {"path": "stable_asr/references/collections.py", "required_now": true},
        {"path": "stable_asr/references/turn_collections.py", "required_now": true},
        {"path": "stable_asr/paper/adapter_pack.py", "required_now": true}
      ],
      "commands": [
        "stable-asr data-sources --registry configs/datasets/stable_asr_sources.json --validate-only",
        "stable-asr adapter-registry --registry configs/adapters/stable_asr_adapters.json --validate-only",
        "stable-asr asr-collections --registry configs/references/asr_collections.json --validate-only",
        "stable-asr asr-collections --audit-coverage --require-priority p0 --require-priority p1",
        "stable-asr asr-collections --format acquisition-markdown --output runs/ASR_COLLECTION_ACQUISITION.md",
        "stable-asr turn-collections --registry configs/references/turn_collections.json --validate-only",
        "stable-asr turn-collections --audit-coverage --require-priority p0 --require-priority p1",
        "stable-asr adapter-pack --output-dir runs/adapter_pack"
      ],
      "success_criteria": [
        "P0/P1 ASR references have adapter or bridge evidence",
        "top ASR reference collection has an acquisition plan that maps every entry to an evidence target",
        "P0/P1 turn/full-duplex references have data-source or adapter evidence",
        "public ASR metadata can be normalized into canonical ASR manifests",
        "ASR manifests can bootstrap weak turn windows and leakage-audited splits",
        "external ASR contributors can generate a command-adapter starter pack with registries, fixtures, and script templates"
      ]
    },
    {
      "id": "m3_streaming_voiceworld",
      "title": "Streaming ASR And VoiceWorld",
      "status": "complete",
      "objective": "Evaluate streaming ASR traces and controllable full-duplex VoiceWorld scenarios beyond static WER/CER.",
      "artifacts": [
        {"path": "configs/scenarios/stable_asr_voiceworld_v0.json", "required_now": true},
        {"path": "stable_asr/streaming/metrics.py", "required_now": true},
        {"path": "stable_asr/streaming/compare.py", "required_now": true},
        {"path": "stable_asr/streaming/sweep.py", "required_now": true},
        {"path": "stable_asr/streaming/command_compare.py", "required_now": true},
        {"path": "stable_asr/scenarios/world.py", "required_now": true},
        {"path": "stable_asr/scenarios/voice_world.py", "required_now": true},
        {"path": "stable_asr/scenarios/synthetic_turn.py", "required_now": true},
        {"path": "tests/fixtures/streaming_asr_sample.jsonl", "required_now": true},
        {"path": "examples/configs/asr_command_compare_demo.json", "required_now": true}
      ],
      "commands": [
        "stable-asr eval-streaming-asr --input tests/fixtures/streaming_asr_sample.jsonl",
        "stable-asr compare-streaming-asr --input balanced=tests/fixtures/streaming_asr_sample.jsonl --input fast_unstable=tests/fixtures/streaming_asr_fast_unstable_sample.jsonl",
        "stable-asr sweep-streaming-asr --input tests/fixtures/streaming_asr_sample.jsonl --chunks-ms 160 320 640 --lookahead-ms 0 160",
        "stable-asr eval-scenario --episodes 21 --seed 0 --baseline vad_pause"
      ],
      "success_criteria": [
        "streaming traces report latency, stability, endpoint, timestamp, WER, and CER metrics",
        "VoiceWorld exposes a stable-worldmodel-style Python World API for sampling, collection, and evaluation",
        "scenario suites cover incomplete pauses, interruptions, backchannels, side speech, ambient speech, noise, and code switching",
        "external ASR commands can be compared without importing heavyweight ASR dependencies"
      ]
    },
    {
