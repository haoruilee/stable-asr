{
  "id": "stable_asr_schema_registry_v0",
  "version": "0.1.0",
  "title": "Stable-ASR Schema Registry",
  "description": "Machine-readable JSON Schema contracts for Stable-ASR manifests, predictions, streaming traces, leaderboards, and registries.",
  "schemas": [
    {
      "id": "stable_asr.turn_manifest_record.v0",
      "version": "0.1.0",
      "title": "Turn Manifest Record",
      "description": "One turn-taking training or evaluation window.",
      "format": "jsonl",
      "file_patterns": ["*.jsonl", "*.parquet", "*.lance"],
      "producer_commands": [
        "stable-asr make-synthetic-turn-data",
        "stable-asr prepare-voiceworld",
        "stable-asr asr-to-turn",
        "stable-asr split-turn-data"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/turn_manifest_record.v0.json",
        "title": "Stable-ASR TurnManifestRecord v0",
        "type": "object",
        "required": [
          "id",
          "audio",
          "sample_rate",
          "start",
          "end",
          "turn_label",
          "action_label",
          "assistant_speaking",
          "overlap",
          "language",
          "source"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "audio": {"type": "string", "minLength": 1},
          "sample_rate": {"type": "integer", "minimum": 1},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "turn_label": {"type": "string", "enum": ["backchannel", "complete", "incomplete", "wait"]},
          "action_label": {
            "type": "string",
            "enum": [
              "continue_speaking",
              "hold",
              "ignore",
              "keep_listening",
              "light_ack",
              "stop_tts_and_listen",
              "take_turn"
            ]
          },
          "assistant_speaking": {"type": "boolean"},
          "overlap": {"type": "boolean"},
          "language": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "text": {"type": ["string", "null"]},
          "asr_text": {"type": ["string", "null"]},
          "scenario": {"type": ["string", "null"]},
          "metadata": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.asr_manifest_record.v0",
      "version": "0.1.0",
      "title": "ASR Manifest Record",
      "description": "One utterance-level ASR corpus item before turn/action windowing.",
      "format": "jsonl",
      "file_patterns": ["asr_manifest.jsonl"],
      "producer_commands": [
        "stable-asr prepare-asr-manifest",
        "stable-asr prepare-public-asr"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/asr_manifest_record.v0.json",
        "title": "Stable-ASR ASRManifestRecord v0",
        "type": "object",
        "required": ["id", "audio", "sample_rate", "text", "language", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "audio": {"type": "string", "minLength": 1},
          "sample_rate": {"type": "integer", "minimum": 1},
          "text": {"type": "string"},
          "language": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "duration": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "split": {"type": ["string", "null"]},
          "speaker_id": {"type": ["string", "null"]},
          "metadata": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.streaming_asr_record.v0",
      "version": "0.1.0",
      "title": "Streaming ASR Record",
      "description": "One streaming ASR trace with final text, partial hypotheses, timestamps, and latency inputs.",
      "format": "jsonl",
      "file_patterns": ["streaming_asr*.jsonl", "*_streaming.jsonl"],
      "producer_commands": [
        "stable-asr convert-asr-transcript",
        "stable-asr eval-asr-command"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/streaming_asr_record.v0.json",
        "title": "Stable-ASR StreamingASRRecord v0",
        "type": "object",
        "required": ["id", "reference", "final_text", "audio_duration", "processing_time"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reference": {"type": "string"},
          "final_text": {"type": "string"},
          "audio_duration": {"type": "number", "minimum": 0},
          "processing_time": {"type": "number", "minimum": 0},
          "speech_end_time": {"type": ["number", "null"], "minimum": 0},
          "endpoint_time": {"type": ["number", "null"], "minimum": 0},
          "word_timestamps": {
            "type": "array",
            "items": {"$ref": "#/$defs/word_timestamp"}
          },
          "reference_word_timestamps": {
            "type": "array",
            "items": {"$ref": "#/$defs/word_timestamp"}
          },
          "partials": {
            "type": "array",
            "items": {"$ref": "#/$defs/partial_hypothesis"}
          },
          "metadata": {"type": "object"}
        },
        "$defs": {
          "word_timestamp": {
            "type": "object",
            "required": ["word", "start", "end"],
            "properties": {
              "word": {"type": "string"},
              "start": {"type": "number", "minimum": 0},
              "end": {"type": "number", "minimum": 0}
            },
            "additionalProperties": true
          },
          "partial_hypothesis": {
            "type": "object",
            "required": ["time", "text"],
            "properties": {
              "time": {"type": "number", "minimum": 0},
              "text": {"type": "string"},
              "is_final": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.turn_prediction_record.v0",
      "version": "0.1.0",
      "title": "Turn Prediction Record",
      "description": "One external or exported turn prediction row keyed by manifest record id.",
      "format": "jsonl",
      "file_patterns": ["*predictions*.jsonl"],
      "producer_commands": [
        "stable-asr predict-turn",
        "stable-asr convert-predictions"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/turn_prediction_record.v0.json",
        "title": "Stable-ASR TurnPredictionRow v0",
        "type": "object",
        "required": ["id"],
        "anyOf": [
          {"required": ["probs"]},
          {"required": ["label"]}
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string", "enum": ["backchannel", "complete", "incomplete", "wait"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "probs": {
            "type": "object",
            "minProperties": 1,
            "properties": {
              "backchannel": {"type": "number", "minimum": 0},
              "complete": {"type": "number", "minimum": 0},
              "incomplete": {"type": "number", "minimum": 0},
              "wait": {"type": "number", "minimum": 0}
            },
            "additionalProperties": false
          },
          "timestamp": {"type": ["number", "null"], "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.leaderboard_row.v0",
      "version": "0.1.0",
      "title": "Leaderboard Row",
      "description": "One normalized benchmark metric row exported from paper result artifacts.",
      "format": "jsonl",
      "file_patterns": ["leaderboard.jsonl", "leaderboard.csv"],
      "producer_commands": ["stable-asr leaderboard-export"],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/leaderboard_row.v0.json",
        "title": "Stable-ASR LeaderboardRow v0",
        "type": "object",
        "required": [
          "suite",
          "task",
          "system",
          "slice",
          "metric",
          "value",
          "unit",
          "higher_is_better",
          "source"
        ],
        "properties": {
          "suite": {"type": "string", "minLength": 1},
          "task": {"type": "string", "minLength": 1},
          "system": {"type": "string", "minLength": 1},
          "slice": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "unit": {"type": "string"},
          "higher_is_better": {"type": "boolean"},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.model_registry.v0",
      "version": "0.1.0",
      "title": "Model Registry",
      "description": "Built-in model and baseline registry used by reports and model cards.",
      "format": "json",
      "file_patterns": ["configs/models/stable_asr_models.json", "model_registry.json"],
      "producer_commands": ["stable-asr model-registry"],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/model_registry.v0.json",
        "title": "Stable-ASR ModelRegistry v0",
        "type": "object",
        "required": ["id", "version", "title", "models"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "models": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/model"}
          }
        },
        "$defs": {
          "model": {
            "type": "object",
            "required": [
              "id",
              "title",
              "family",
              "task",
              "model_type",
              "status",
              "modality",
              "interface",
              "entrypoint",
              "input_schema",
              "output_schema",
              "license"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "family": {"type": "string", "minLength": 1},
              "task": {"type": "string", "minLength": 1},
              "model_type": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "modality": {"type": "string", "minLength": 1},
              "interface": {"type": "string", "minLength": 1},
              "entrypoint": {"type": "string", "minLength": 1},
              "training_entrypoint": {"type": "string"},
              "evaluation_entrypoint": {"type": "string"},
              "export_entrypoint": {"type": "string"},
              "input_schema": {"type": "string", "minLength": 1},
              "output_schema": {"type": "string", "minLength": 1},
              "labels": {"type": "array", "items": {"type": "string"}},
              "actions": {"type": "array", "items": {"type": "string"}},
              "config_path": {"type": "string"},
              "license": {"type": "string", "minLength": 1},
              "intended_use": {"type": "string"},
              "limitations": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.nanoturn_train_config.v0",
      "version": "0.1.0",
      "title": "NanoTurn Training Config",
      "description": "Trainable NanoTurn configuration consumed by train-turn --config.",
      "format": "json",
      "file_patterns": ["configs/nanoturn_*.json", "nanoturn_*.json"],
      "producer_commands": [
        "stable-asr train-turn --config <config.json>",
        "stable-asr model-registry --audit-configs"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/nanoturn_train_config.v0.json",
        "title": "Stable-ASR NanoTurnTrainConfig v0",
        "type": "object",
        "required": ["model_type", "epochs", "lr", "seed", "feature_source"],
        "properties": {
          "model_type": {"type": "string", "enum": ["nanoturn_pico", "nanoturn_nano"]},
          "epochs": {"type": "integer", "minimum": 1},
          "lr": {"type": "number", "exclusiveMinimum": 0},
          "seed": {"type": "integer"},
          "feature_source": {
            "type": "string",
            "enum": [
              "metadata",
              "audio",
              "manifest_metadata_v0",
              "metadata_v0",
              "logmel_v0",
              "audio_logmel_v0"
            ]
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.final_input_collection.v0",
      "version": "0.1.0",
      "title": "Final Input Collection Registry",
      "description": "Operational registry for collecting real corpora, external predictions, and final paper artifacts.",
      "format": "json",
      "file_patterns": ["configs/final/input_collections.json", "final_input_collections.json"],
      "producer_commands": ["stable-asr final-inputs"],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/final_input_collection.v0.json",
        "title": "Stable-ASR FinalInputCollections v0",
        "type": "object",
        "required": ["id", "version", "title", "collections"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "collections": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/collection"}
          }
        },
        "$defs": {
          "collection": {
            "type": "object",
            "required": [
              "id",
              "title",
              "category",
              "priority",
              "required",
              "license",
              "required_paths",
              "generated_paths",
              "commands",
              "verification"
            ],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "title": {"type": "string", "minLength": 1},
              "category": {"type": "string", "minLength": 1},
              "priority": {"type": "string", "enum": ["p0", "p1", "p2"]},
              "required": {"type": "boolean"},
              "license": {"type": "string", "minLength": 1},
              "source_urls": {"type": "array", "items": {"type": "string"}},
              "required_paths": {"type": "array", "items": {"type": "string"}},
              "generated_paths": {"type": "array", "items": {"type": "string"}},
              "commands": {"type": "array", "items": {"type": "string"}},
              "verification": {"type": "array", "items": {"type": "string"}},
              "notes": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.reference_source_manifest.v0",
      "version": "0.1.0",
      "title": "Reference Source Manifest",
      "description": "Machine-readable source, license, acquisition, and evidence targets for ASR or turn reference collections.",
      "format": "json",
      "file_patterns": ["*collection_source_manifest.json", "*reference_source_manifest.json"],
      "producer_commands": [
        "stable-asr asr-collections --format source-manifest",
        "stable-asr turn-collections --format source-manifest"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/reference_source_manifest.v0.json",
        "title": "Stable-ASR ReferenceSourceManifest v0",
        "type": "object",
        "required": ["id", "version", "collection_type", "registry_id", "reviewed_at", "generated_by", "sources"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "collection_type": {"type": "string", "enum": ["asr", "turn"]},
          "registry_id": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "minLength": 1},
          "generated_by": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/source"}
          }
        },
        "$defs": {
          "source": {
            "type": "object",
            "required": [
              "reference_id",
              "name",
              "collection_type",
              "category",
              "priority",
              "source_url",
              "docs_url",
              "license",
              "policy",
              "license_review_required",
              "license_review_target",
              "acquisition_track",
              "evidence_target",
              "stable_asr_actions",
              "reference_use"
            ],
            "properties": {
              "reference_id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "collection_type": {"type": "string", "enum": ["asr", "turn"]},
              "category": {"type": "string", "minLength": 1},
              "priority": {"type": "string", "enum": ["p0", "p1", "p2"]},
              "source_url": {"type": "string", "minLength": 1},
              "docs_url": {"type": "string", "minLength": 1},
              "license": {"type": "string", "minLength": 1},
              "policy": {"type": "string", "minLength": 1},
              "license_review_required": {"type": "boolean"},
              "license_review_target": {"type": "string", "minLength": 1},
              "citation_key": {"type": "string"},
              "acquisition_track": {"type": "string", "minLength": 1},
              "evidence_target": {"type": "string", "minLength": 1},
              "stable_asr_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "reference_use": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.reference_workqueue.v0",
      "version": "0.1.0",
      "title": "Reference Work Queue",
      "description": "Unified contributor work queue generated from ASR and turn reference source manifests.",
      "format": "json",
      "file_patterns": ["reference_workqueue.json", "*REFERENCE_WORKQUEUE*.json"],
      "producer_commands": [
        "stable-asr reference-workqueue"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/reference_workqueue.v0.json",
        "title": "Stable-ASR ReferenceWorkQueue v0",
        "type": "object",
        "required": ["id", "version", "generated_by", "required_priorities", "tasks"],
        "properties": {
          "id": {"type": "string", "const": "stable_asr_reference_workqueue_v0"},
          "version": {"type": "string", "minLength": 1},
          "generated_by": {"type": "string", "minLength": 1},
          "required_priorities": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "enum": ["p0", "p1", "p2"]}
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/task"}
          }
        },
        "$defs": {
          "task": {
            "type": "object",
            "required": [
              "task_id",
              "collection_type",
              "reference_id",
              "name",
              "category",
              "priority",
              "acquisition_track",
              "evidence_target",
              "license",
              "policy",
              "license_review_required",
              "license_review_target",
              "source_url",
              "docs_url",
              "status",
              "next_action",
              "blocked_by",
              "stable_asr_actions",
              "reference_use"
            ],
            "properties": {
              "task_id": {"type": "string", "minLength": 1},
              "collection_type": {"type": "string", "enum": ["asr", "turn"]},
              "reference_id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "category": {"type": "string", "minLength": 1},
              "priority": {"type": "string", "enum": ["p0", "p1", "p2"]},
              "acquisition_track": {"type": "string", "minLength": 1},
              "evidence_target": {"type": "string", "minLength": 1},
              "license": {"type": "string", "minLength": 1},
              "policy": {"type": "string", "minLength": 1},
              "license_review_required": {"type": "boolean"},
              "license_review_target": {"type": "string", "minLength": 1},
              "source_url": {"type": "string", "minLength": 1},
              "docs_url": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "next_action": {"type": "string", "minLength": 1},
              "blocked_by": {"type": "array", "items": {"type": "string"}},
              "stable_asr_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "reference_use": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    {
      "id": "stable_asr.reference_assignments.v0",
      "version": "0.1.0",
      "title": "Reference Assignments",
      "description": "Owner-fillable assignment tracker generated from the Stable-ASR reference work queue.",
      "format": "json",
      "file_patterns": ["reference_assignments.json", "*REFERENCE_ASSIGNMENTS*.json"],
      "producer_commands": [
        "stable-asr reference-workqueue --format assignments-json"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://stable-asr.dev/schemas/reference_assignments.v0.json",
        "title": "Stable-ASR ReferenceAssignments v0",
        "type": "object",
        "required": ["id", "version", "generated_by", "source_workqueue_id", "rows"],
        "properties": {
          "id": {"type": "string", "const": "stable_asr_reference_assignments_v0"},
          "version": {"type": "string", "minLength": 1},
          "generated_by": {"type": "string", "minLength": 1},
          "source_workqueue_id": {"type": "string", "minLength": 1},
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/row"}
          }
        },
        "$defs": {
          "row": {
            "type": "object",
            "required": [
              "task_id",
              "collection_type",
              "reference_id",
              "name",
              "priority",
              "category",
              "owner",
              "due_date",
              "status",
              "blocking_release",
              "evidence_target",
              "license",
              "license_review_required",
              "license_review_target",
              "next_action",
              "blocked_by",
              "source_url",
              "docs_url",
              "notes"
            ],
            "properties": {
              "task_id": {"type": "string", "minLength": 1},
              "collection_type": {"type": "string", "enum": ["asr", "turn"]},
              "reference_id": {"type": "string", "minLength": 1},
              "name": {"type": "string", "minLength": 1},
              "priority": {"type": "string", "enum": ["p0", "p1", "p2"]},
              "category": {"type": "string", "minLength": 1},
              "owner": {"type": "string"},
              "due_date": {"type": "string"},
              "status": {"type": "string", "minLength": 1},
              "blocking_release": {"type": "boolean"},
              "evidence_target": {"type": "string", "minLength": 1},
              "license": {"type": "string", "minLength": 1},
              "license_review_required": {"type": "boolean"},
              "license_review_target": {"type": "string", "minLength": 1},
              "next_action": {"type": "string", "minLength": 1},
              "blocked_by": {"type": "array", "items": {"type": "string"}},
              "source_url": {"type": "string", "minLength": 1},
              "docs_url": {"type": "string", "minLength": 1},
              "notes": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    {
