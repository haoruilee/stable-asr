{
  "timeout_sec": 900,
  "input_manifest": "runs/final/asr_eval_manifest.jsonl",
  "adapters": [
    {
      "name": "whisper_final",
      "command": [
        "python3",
        "scripts/export_streaming_transcript.py",
        "--schema",
        "whisper",
        "--manifest",
        "{input_manifest}",
        "--raw",
        "runs/final/asr_commands/raw/whisper_raw.jsonl",
        "--output",
        "{output}"
      ],
      "output": "runs/final/asr_commands/whisper_streaming.jsonl",
      "required_inputs": [
        "runs/final/asr_commands/raw/whisper_raw.jsonl"
      ]
    },
    {
      "name": "funasr_final",
      "command": [
        "python3",
        "scripts/export_streaming_transcript.py",
        "--schema",
        "funasr",
        "--manifest",
        "{input_manifest}",
        "--raw",
        "runs/final/asr_commands/raw/funasr_raw.jsonl",
        "--output",
        "{output}"
      ],
      "output": "runs/final/asr_commands/funasr_streaming.jsonl",
      "required_inputs": [
        "runs/final/asr_commands/raw/funasr_raw.jsonl"
      ]
    },
    {
      "name": "qwen3_asr_final",
      "command": [
        "python3",
        "scripts/export_streaming_transcript.py",
        "--schema",
        "qwen3_asr",
        "--manifest",
        "{input_manifest}",
        "--raw",
        "runs/final/asr_commands/raw/qwen3_asr_raw.jsonl",
        "--output",
        "{output}"
      ],
      "output": "runs/final/asr_commands/qwen3_asr_streaming.jsonl",
      "required_inputs": [
        "runs/final/asr_commands/raw/qwen3_asr_raw.jsonl"
      ]
    },
    {
      "name": "firered_asr2s_final",
      "command": [
        "python3",
        "scripts/export_streaming_transcript.py",
        "--schema",
        "firered_asr2s",
        "--manifest",
        "{input_manifest}",
        "--raw",
        "runs/final/asr_commands/raw/firered_asr2s_raw.jsonl",
        "--output",
        "{output}"
      ],
      "output": "runs/final/asr_commands/firered_asr2s_streaming.jsonl",
      "required_inputs": [
        "runs/final/asr_commands/raw/firered_asr2s_raw.jsonl"
      ]
    }
  ]
}
