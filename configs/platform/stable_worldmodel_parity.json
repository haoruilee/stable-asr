{
  "id": "stable_asr_stable_worldmodel_parity_v0",
  "version": "0.1.0",
  "reviewed_at": "2026-06-01",
  "title": "Stable-ASR Stable-WorldModel Repository Parity",
  "description": "Repository-level parity checklist for keeping Stable-ASR shaped like a stable-worldmodel-style platform: installable package, data formats, scenarios, baselines, solvers, paper/release artifacts, docs, and contribution surfaces.",
  "source_reference": "https://github.com/galilai-group/stable-worldmodel",
  "items": [
    {
      "id": "repository_identity",
      "stable_worldmodel_reference": "README, badges, installation, quick start, documentation, paper link, and citation surface.",
      "required_paths": ["README.md", "pyproject.toml", "LICENSE", "CITATION.cff", "docs/index.md", "mkdocs.yaml"],
      "required_commands": ["stable-asr doctor", "stable-asr roadmap-status --roadmap configs/roadmap/stable_asr_roadmap.json"],
      "required_markers": [
        {"path": "README.md", "contains": ["Installation", "Quick Start", "Paper And Release Smoke"]},
        {"path": "ROADMAP.md", "contains": ["Stable-WorldModel Analogy", "Stable-WorldModel Paper Parity Plan"]}
      ]
    },
    {
      "id": "installable_cli_surface",
      "stable_worldmodel_reference": "A package-level CLI for inspecting, converting, listing, and running platform tasks.",
      "required_paths": ["stable_asr/cli.py", ".github/workflows/tests.yml", "docs/cli.md"],
      "required_commands": ["stable-asr doctor", "stable-asr labels", "stable-asr data-sources --validate-only", "stable-asr scenario-suite --validate-only"],
      "required_markers": [
        {"path": "README.md", "contains": ["stable-asr doctor", "stable-asr paper-release-smoke"]}
      ]
    },
    {
      "id": "data_format_registry",
      "stable_worldmodel_reference": "A small format registry with default high-throughput storage and conversion paths.",
      "required_paths": [
        "stable_asr/data/registry.py",
        "stable_asr/data/formats/jsonl.py",
        "stable_asr/data/formats/parquet.py",
        "stable_asr/data/formats/lance.py",
        "stable_asr/data/benchmark.py",
        "configs/datasets/stable_asr_sources.json"
      ],
      "required_commands": ["stable-asr convert examples/data/turn_demo.jsonl runs/turn_demo.lance", "stable-asr benchmark-data --dataset examples/data/turn_demo.jsonl"],
      "required_markers": [
        {"path": "README.md", "contains": ["Data Formats", "lance", "parquet", "jsonl"]}
      ]
    },
    {
      "id": "scenario_environment_suite",
      "stable_worldmodel_reference": "Registered environments with factors of variation and reproducible evaluation entrypoints.",
      "required_paths": [
        "stable_asr/scenarios/voice_world.py",
        "stable_asr/scenarios/suites.py",
        "stable_asr/scenarios/synthetic_turn.py",
        "configs/scenarios/stable_asr_voiceworld_v0.json",
        "docs/voiceworld.md"
      ],
      "required_commands": ["stable-asr scenario-suite --suite configs/scenarios/stable_asr_voiceworld_v0.json --validate-only", "stable-asr eval-scenario --episodes 21 --seed 0 --baseline vad_pause", "stable-asr scenario-pack --output-dir runs/scenario_pack"],
      "required_markers": [
        {"path": "README.md", "contains": ["VoiceWorld Scenarios", "Factors of variation"]}
      ]
    },
    {
      "id": "baseline_adapter_solver_zoo",
      "stable_worldmodel_reference": "Reference baselines and solvers exposed through one interface.",
      "required_paths": [
        "stable_asr/models/baselines/rule_endpoint.py",
        "stable_asr/models/baselines/vad_pause.py",
        "stable_asr/models/baselines/text_turn.py",
        "stable_asr/models/adapters/registry.py",
        "stable_asr/turn/nanoturn.py",
        "stable_asr/turn/solver.py",
        "configs/adapters/stable_asr_adapters.json",
        "configs/models/stable_asr_models.json"
      ],
      "required_commands": ["stable-asr compare-turn --dataset examples/data/turn_demo.jsonl --baseline vad_pause --baseline text_turn", "stable-asr optimize-policy --dataset examples/data/turn_demo.jsonl --baseline vad_pause", "stable-asr adapter-registry --validate-only", "stable-asr model-registry --validate-only"],
      "required_markers": [
        {"path": "README.md", "contains": ["Baselines And Adapters", "NanoTurn"]}
      ]
    },
    {
      "id": "paper_release_pipeline",
      "stable_worldmodel_reference": "Reproducible paper-facing scripts, reports, figures, benchmark assets, archive, and release audit.",
      "required_paths": [
        "configs/paper/paper_smoke.json",
        "configs/paper/paper_parity_checklist.json",
        "configs/paper/final_experiments.json",
        "configs/final/paper_final.json",
        "configs/benchmarks/stable_asr_v0.json",
        "stable_asr/paper/artifacts.py",
        "stable_asr/paper/audit.py",
        "stable_asr/paper/release_smoke.py",
        "scripts/reproduce_paper.py"
      ],
      "required_commands": ["stable-asr reproduce-paper --config configs/paper/paper_smoke.json", "stable-asr paper-bundle --results runs/paper/smoke/paper_results.json --output-dir runs/paper/smoke/artifacts", "stable-asr paper-release-smoke --output-dir runs/paper/release_smoke", "stable-asr paper-release-audit --repo-root . --results runs/paper/smoke/paper_results.json --artifacts-dir runs/paper/smoke/artifacts"],
      "required_markers": [
        {"path": "docs/release_gates.md", "contains": ["Release Audit", "paper-release-smoke"]}
      ]
    },
    {
      "id": "contributor_extension_surface",
      "stable_worldmodel_reference": "Clear extension points for adding environments, adapters, benchmark submissions, and paper inputs.",
      "required_paths": [
        "CONTRIBUTING.md",
        ".github/PULL_REQUEST_TEMPLATE.md",
        ".github/ISSUE_TEMPLATE/asr_adapter.yml",
        ".github/ISSUE_TEMPLATE/voiceworld_scenario.yml",
        ".github/ISSUE_TEMPLATE/benchmark_submission.yml",
        "stable_asr/paper/benchmark_pack.py",
        "stable_asr/paper/adapter_pack.py",
        "stable_asr/paper/scenario_pack.py",
        "stable_asr/paper/contributor_pack.py"
      ],
      "required_commands": ["stable-asr benchmark-pack --output-dir runs/benchmark_pack", "stable-asr adapter-pack --output-dir runs/adapter_pack", "stable-asr scenario-pack --output-dir runs/scenario_pack", "stable-asr contributor-pack --output-dir runs/contributor_pack"],
      "required_markers": [
        {"path": "README.md", "contains": ["contributor-pack", "benchmark-pack", "adapter-pack", "scenario-pack"]}
      ]
    },
    {
      "id": "reference_collections",
      "stable_worldmodel_reference": "Curated ecosystem references and collection plans instead of an isolated model repository.",
      "required_paths": [
        "configs/references/asr_collections.json",
        "configs/references/turn_collections.json",
        "docs/asr_collections.md",
        "docs/turn_collections.md",
        "stable_asr/references/collections.py",
        "stable_asr/references/turn_collections.py"
      ],
      "required_commands": ["stable-asr asr-collections --audit-coverage", "stable-asr asr-collections --audit-readiness", "stable-asr turn-collections --audit-coverage"],
      "required_markers": [
        {"path": "README.md", "contains": ["Reference coverage", "asr_collections.json", "turn_collections.json"]}
      ]
    }
  ]
}
